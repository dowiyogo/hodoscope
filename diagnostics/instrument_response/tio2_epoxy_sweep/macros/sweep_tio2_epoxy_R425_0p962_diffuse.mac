# TiO2+epoxy reflector sweep macro: sweep_tio2_epoxy_R425_0p962_diffuse
/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0
/analysis/setFileName diagnostics/instrument_response/tio2_epoxy_sweep/outputs/sweep_tio2_epoxy_R425_0p962_diffuse.root
/hodoscope/setDetectorVariant Hod2019
/hodoscope/det/optical true
/hodoscope/det/improvedOptical true
/hodoscope/det/setD 5.0 mm
/hodoscope/det/tio2EpoxyEffectiveR425 0.962
/hodoscope/det/tio2EpoxySurfaceMode diffuse
/run/initialize
/gun/particle mu-
/gun/energy 4.0 GeV
/gun/position 0.0 0.0 50.0 mm
/gun/direction 0.0 0.0 -1.0
/run/beamOn 2000
