# Short non-optical Iteration 0 sanity run for MT validation after optical port.

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/analysis/setFileName diagnostics/optical_branch_diff/outputs/iteration0_sanity_short.root
/hodoscope/det/setD 5.0 mm
/hodoscope/det/optical false

/run/initialize

/gun/particle mu-
/gun/energy 4.0 GeV
/gun/position 0.0 0.0 50.0 mm
/gun/direction 0.0 0.0 -1.0

/run/beamOn 20
