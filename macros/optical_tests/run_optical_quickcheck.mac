# run_optical_quickcheck.mac
# Minimal optical quickcheck to diagnose whether optical photons reach the SiPM.

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/analysis/setFileName optical_quickcheck.root
/hodoscope/setDetectorVariant Hod2019
/hodoscope/det/optical true
/hodoscope/det/setD 5.0 mm

/run/initialize

/gun/particle mu-
/gun/energy 4.0 GeV
/gun/position 0.0 0.0 50.0 mm
/gun/direction 0.0 0.0 -1.0

/run/beamOn 10
