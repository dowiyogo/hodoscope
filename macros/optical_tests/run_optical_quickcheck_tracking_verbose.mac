# run_optical_quickcheck_tracking_verbose.mac
# Single-event optical diagnostic with tracking verbose enabled.

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 1

/analysis/setFileName optical_quickcheck_tracking_verbose.root
/hodoscope/setDetectorVariant Hod2019
/hodoscope/det/optical true
/hodoscope/det/setD 5.0 mm

/run/initialize

/gun/particle mu-
/gun/energy 4.0 GeV
/gun/position 0.0 0.0 50.0 mm
/gun/direction 0.0 0.0 -1.0

/run/beamOn 1
