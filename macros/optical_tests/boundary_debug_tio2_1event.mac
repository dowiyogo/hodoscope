# One-event optical boundary trace for physical Hod2019/TiO2 mode.

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 1

/analysis/setFileName diagnostics/optical_variant_ratio_debug/outputs/boundary_tio2_1event.root
/hodoscope/setDetectorVariant Hod2019
/hodoscope/det/optical true
/hodoscope/det/improvedOptical true
/hodoscope/det/reflectorDebugMode 0
/hodoscope/det/setD 5.0 mm

/run/initialize

/gun/particle mu-
/gun/energy 4.0 GeV
/gun/position 0.0 0.0 50.0 mm
/gun/direction 0.0 0.0 -1.0

/run/beamOn 1
