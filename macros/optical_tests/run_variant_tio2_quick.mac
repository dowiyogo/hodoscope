# Quick optical comparison run: Hod2019 TiO2 reflector.

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/analysis/setFileName diagnostics/optical_variant_comparison/outputs/variant_tio2_quick.root
/hodoscope/setDetectorVariant Hod2019
/hodoscope/det/optical true
/hodoscope/det/improvedOptical true
/hodoscope/det/setD 5.0 mm

/run/initialize

/gun/particle mu-
/gun/energy 4.0 GeV
/gun/position 0.0 0.0 50.0 mm
/gun/direction 0.0 0.0 -1.0

/run/beamOn 100
