# run_hod2018_vikuiti.mac
#
# Minimal geometry/scoring test for the Hod2018 / Vikuiti variant.
# Optical transport remains disabled.

/run/initialize

/analysis/setFileName output_hod2018_vikuiti.root
/hodoscope/setDetectorVariant Hod2018
/hodoscope/det/setD 5.0 mm
/hodoscope/det/optical false

/gun/particle mu-
/gun/energy 4.0 GeV
/gun/position 0.0 0.0 50.0 mm
/gun/direction 0.0 0.0 -1.0

/run/beamOn 10
