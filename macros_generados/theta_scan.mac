# theta_scan.mac  -  generado por analysis/build_theta_scan.py
# D ∈ [3.0, 5.0, 8.0] mm
# θ_true ∈ [0, 5, 10, 15, 20] mrad
# N muones por (D, θ): 2000
# Total eventos: 30000   (beamOn calls: 15)

/run/initialize

/gun/particle mu-
/gun/energy 4.0 GeV
/gun/position 0.0 0.0 50.0 mm

/run/printProgress 500

# ---- D = 3.0 mm, θ = 0 mrad ------------------------------
/analysis/setFileName theta_scan_D3.0_th0.root
/hodoscope/det/setD 3.0 mm
/gun/direction 0.000000 0.0 -1.000000
/run/beamOn 2000

# ---- D = 3.0 mm, θ = 5 mrad ------------------------------
